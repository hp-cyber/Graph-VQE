# Copy to campaign_storage.env and choose a writable directory on your data disk.
# Existing case manifests retain their recorded destinations on resume.
export CAMPAIGN_RECORDS_ROOT="${CAMPAIGN_RECORDS_ROOT:-/data/YOUR_USER/graph_vqe_records}"
